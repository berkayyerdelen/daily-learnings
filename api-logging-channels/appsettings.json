{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ApiLogs": "Server=localhost,1434;Database=api_logging;User Id=sa;Password=Your_strong_Passw0rd;TrustServerCertificate=True"
  },
  "ApiLogging": {
    "Provider": "SqlServer",
    "Enabled": true,
    "ChannelCapacity": 10000,
    "BatchSize": 500,
    "FlushInterval": "00:00:02",
    "WriterConcurrency": 1,
    "MaxRetries": 3,
    "BodySampleRate": 1.0,
    "AlwaysLogBodiesOnError": true,
    "MaxBodyLength": 8192,
    "WriteTimeout": "00:00:30",
    "EnsureSchema": false
  }
}
