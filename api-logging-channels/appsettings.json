{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ApiLogs": "Server=localhost,1434;Database=api_logging;User Id=sa;Password=Your_strong_Passw0rd;TrustServerCertificate=True"
  },
  "ApiLogging": {
    "Capacity": 10000,
    "MaxQueueBytes": 268435456,
    "BatchSize": 1000,
    "FlushInterval": "00:00:02",
    "MaxRetries": 3,
    "RetryBaseDelay": "00:00:00.200"
  }
}
